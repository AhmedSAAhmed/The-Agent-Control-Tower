# Free-tier LLM keys. Any subset works; with none, agents run on the scripted brain.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# hybrid (LLM first, scripted fallback) | live (LLM only) | scripted (no LLM)
LLM_MODE=hybrid
# Max LLM calls per minute across the whole fleet (protects free quotas)
LLM_RPM=14
